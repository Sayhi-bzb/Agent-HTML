{
  "name": "agent-html",
  "private": true,
  "version": "0.1.0-alpha.2",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run react-canvas:dev",
    "react-canvas:dev": "node packages/cli/bin/agent-html.mjs dev",
    "react-canvas:deps": "depcruise --config .dependency-cruiser.mjs --output-type err agent-html",
    "react-canvas:guard": "node packages/cli/bin/agent-html.mjs guard",
    "react-canvas:index": "node tools/generate-react-canvas-index.mjs",
    "react-canvas:index:check": "node tools/generate-react-canvas-index.mjs --check",
    "react-canvas:typecheck": "tsc --noEmit -p config/tsconfig/tsconfig.react-canvas.json",
    "dev:docs": "npm --workspace @agent-html/docs run dev",
    "build": "npm run react-canvas:typecheck && npm run build:docs",
    "build:docs": "npm --workspace @agent-html/docs run build",
    "bridge:agent": "node tools/agent-html-bridge.mjs",
    "bridge:claude-channel": "node tools/agent-html-claude-channel-bridge.mjs",
    "lint": "eslint . --config config/eslint.config.js",
    "knip": "knip",
    "knip:report": "knip --no-exit-code --reporter compact",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run --config config/vitest.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "knip": "^6.14.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  },
  "description": "[English](./README.md)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sayhi-bzb/Agent-HTML.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Sayhi-bzb/Agent-HTML/issues"
  },
  "homepage": "https://github.com/Sayhi-bzb/Agent-HTML#readme"
}
