{
  "name": "agent-html-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run canvas:dev",
    "build": "npm run typecheck && npm run docs:build && npm run desktop:build",
    "test": "npm run canvas:test && npm run desktop:test",
    "typecheck": "tsc --noEmit && npm --workspace @agent-html/docs run typecheck && npm --workspace @agent-html/desktop run typecheck",
    "lint": "eslint agent-html apps/desktop packages tools config --config config/eslint.config.js && npm --workspace @agent-html/docs run lint",
    "format": "prettier --write \"agent-html/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"apps/desktop/**/*.{ts,tsx}\" \"config/**/*.{ts,tsx}\" && npm --workspace @agent-html/docs run format",
    "canvas:dev": "node packages/cli/bin/agent-html.mjs dev",
    "canvas:deps": "depcruise --config .dependency-cruiser.mjs --output-type err agent-html",
    "canvas:guard": "node packages/cli/bin/agent-html.mjs guard",
    "canvas:index": "node tools/generate-react-canvas-index.mjs",
    "canvas:index:check": "node tools/generate-react-canvas-index.mjs --check",
    "canvas:typecheck": "tsc --noEmit -p config/tsconfig/tsconfig.react-canvas.json",
    "canvas:test": "vitest run --config config/vitest.config.mjs",
    "example:dev": "node packages/cli/bin/agent-html.mjs dev --pipeline example",
    "example:build": "node packages/cli/bin/agent-html.mjs demo-build --out-dir dist-agent-html",
    "site:build": "npm run example:build && npm run docs:build && node tools/build-agent-html-site.mjs",
    "docs:dev": "npm --workspace @agent-html/docs run dev",
    "docs:build": "npm --workspace @agent-html/docs run build",
    "desktop:build": "npm --workspace @agent-html/desktop run build",
    "desktop:dev": "npm --workspace @agent-html/desktop run tauri dev",
    "desktop:e2e": "npm --workspace @agent-html/desktop run e2e",
    "desktop:package": "npm --workspace @agent-html/desktop run tauri -- build",
    "desktop:test": "npm --workspace @agent-html/desktop run test",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "knip": "^6.14.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sayhi-bzb/Agent-HTML.git"
  },
  "bugs": {
    "url": "https://github.com/Sayhi-bzb/Agent-HTML/issues"
  },
  "homepage": "https://github.com/Sayhi-bzb/Agent-HTML#readme"
}
