{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/agent-html-app/src/main.tsx",
    "apps/agent-html-app/vite.config.ts",
    "apps/agent-html-example/src/app/main.tsx",
    "apps/agent-html-example/vite.config.ts",
    "packages/agent-html/src/index.ts",
    "tools/*.mjs",
    "config/*.js",
    "config/*.ts",
    "config/*.mjs"
  ],
  "project": [
    "apps/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "packages/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "tools/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "config/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
  ],
  "ignoreWorkspaces": [
    "apps/docs"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.react-router/**",
    "**/.vite/**",
    "apps/agent-html-app/src/locales/messages.d.ts",
    "apps/agent-html-example/public/_worker.js",
    "config/apps/**",
    "apps/docs/vite.config.ts",
    "src-tauri/**"
  ],
  "ignoreIssues": {
    "apps/agent-html-app/src/shared/ui/**": ["exports", "types"],
    "apps/agent-html-example/src/ui/**": ["exports", "types"],
    "apps/agent-html-example/src/cases/introduce-agent-html.react.tsx": ["exports"],
    "apps/agent-html-app/src/pet/host/pet-panel.tsx": ["exports"]
  },
  "ignoreDependencies": [
    "@tauri-apps/cli",
    "shadcn",
    "wrangler"
  ]
}
