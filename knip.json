{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreBinaries": ["gitnexus"],
  "ignoreDependencies": [
    "@tailwindcss/vite",
    "@vitejs/plugin-react",
    "class-variance-authority",
    "clsx",
    "lucide-react",
    "radix-ui",
    "tailwind-merge",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreFiles": [
    "scripts/verify-pack/shadcn-test-fixtures/**/*",
    "packages/ahtml/src/cli/runtime-host/generated-modules.d.ts",
    "packages/ahtml/src/cli/runtime-host/features/gallery/preview-document.mjs.d.ts"
  ],
  "ignoreUnresolved": ["^@/components/ui/"],
  "workspaces": {
    ".": {
      "entry": [
        "packages/core/index.mjs",
        "packages/core/src/schema-overlays.ts",
        "scripts/**/*.mjs",
        "eslint.config.js",
        "vitest.config.ts"
      ],
      "project": [
        "packages/core/**/*.mjs",
        "packages/core/**/*.ts",
        "packages/core/**/*.tsx",
        "scripts/**/*.mjs",
        "scripts/**/*.ts",
        "*.ts",
        "*.js"
      ]
    },
    "packages/ahtml": {
      "entry": [
        "bin/ahtml.mjs",
        "src/cli/index.mjs",
        "src/cli/runtime-host/app.tsx",
        "src/cli/runtime-host/ssr.tsx",
        "src/cli/runtime-host/features/gallery/preview-document.mjs"
      ],
      "project": ["bin/*.mjs", "src/**/*.mjs", "src/**/*.ts", "src/**/*.tsx"],
      "paths": {
        "@/*": ["src/cli/runtime-host/*"]
      },
      "ignoreDependencies": ["@base-ui/react", "react-resizable-panels", "vite"]
    },
    "apps/agent-html-app": {
      "entry": ["src/main.tsx", "vite.config.ts", "vitest.config.ts"],
      "project": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "ignore": ["src/**/*.test.ts"],
      "ignoreBinaries": ["vite", "vitest", "tauri"],
      "ignoreDependencies": ["@tauri-apps/cli"]
    }
  },
  "rules": {
    "exports": "off"
  }
}
