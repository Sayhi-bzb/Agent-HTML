{
  "name": "@agent-html/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/desktop-e2e.mjs",
    "test": "vitest run",
    "tauri": "tauri",
    "runtime:build": "node scripts/runtime-build.mjs",
    "runtime:ensure": "node scripts/runtime-ensure.mjs",
    "runtime:stage": "node scripts/runtime-stage.mjs",
    "runtime:start": "node scripts/runtime-start.mjs",
    "runtime:smoke": "npm run runtime:ensure && node scripts/runtime-sidecar-smoke.mjs",
    "runtime:verify": "npm run runtime:smoke && node scripts/runtime-concurrency-smoke.mjs && node scripts/runtime-interruption-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.7"
  }
}
